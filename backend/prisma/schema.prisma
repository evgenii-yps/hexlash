generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  login           String   @unique
  password        String
  email           String   @default("")
  emailVerified   Boolean  @default(false)
  initialVerified Boolean  @default(true)
  language        String   @default("en")
  name            String   @default("Anonymous")
  avatarUrl       String   @default("")
  isBlocked       Boolean  @default(false)
  balance         Int      @default(0)
  walletAddress   String?
  skin            String   @default("skin_m_1.png")

  rating          Int      @default(1000)
  totalFights     Int      @default(0)
  wins            Int      @default(0)
  losses          Int      @default(0)
  draws           Int      @default(0)

  // PvE statistics
  pveWins         Int      @default(0)
  pveLosses       Int      @default(0)
  pveDraws        Int      @default(0)
  pveTotalFights  Int      @default(0)

  // PvP statistics
  pvpWins         Int      @default(0)
  pvpLosses       Int      @default(0)
  pvpDraws        Int      @default(0)
  pvpTotalFights  Int      @default(0)

  // Taps
  totalTaps       Int      @default(0)

  // Progression (moves, levels, XP per branch)
  progression     Json?

  // Deck (array of module IDs)
  deck            Json?

  // User settings
  settings        Json?
  luckPercentage  Float    @default(0)
  wonTokens       Int      @default(0)
  freeTokens      Int      @default(0)
  lostTokens      Int      @default(0)
  invitedUsers    Int      @default(0)
  noSkipDays      Int      @default(0)

  // Referral system
  referredBy      String?  // login of the user who referred this user

  inviteId        String?  @unique @default(uuid())

  clubId          String?
  clubRole        String?  // "owner", "deputy", "member"
  club            Club?    @relation(fields: [clubId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  achievements    UserAchievement[]
  ownedClubs      Club[]            @relation("ClubOwner")
  socialTasks     UserSocialTask[]
  dailyTasks      UserDailyTask[]
  punchInfo       PunchInfo?

  fightsAsOne     Fight[]  @relation("FighterOne")
  fightsAsTwo     Fight[]  @relation("FighterTwo")
  fightsWon       Fight[]  @relation("FightWinner")

  sentFriendRequests     FriendRequest[] @relation("SentRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedRequests")
  friendships1           Friendship[]    @relation("Friendships1")
  friendships2           Friendship[]    @relation("Friendships2")
}

model Club {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  avatarUrl   String   @default("")
  ownerId     String
  owner       User     @relation("ClubOwner", fields: [ownerId], references: [id])
  balance     Int      @default(0)
  battles     Int      @default(0)
  wins        Int      @default(0)
  isPublic    Boolean  @default(true)
  maxMembers  Int      @default(50)
  members     User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Achievement {
  id          Int     @id @default(autoincrement())
  type        String  @unique
  title       String
  description String  @default("")
  icon        String  @default("")
  users       UserAchievement[]
}

model UserAchievement {
  id            Int         @id @default(autoincrement())
  userId        String
  achievementId Int
  obtainedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id])
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}

model SocialTask {
  id          String  @id @default(uuid())
  title       String
  description String  @default("")
  link        String  @default("")
  tokens      Int     @default(0)
  category    String
  language    String  @default("en")
  users       UserSocialTask[]
}

model UserSocialTask {
  id          Int        @id @default(autoincrement())
  userId      String
  taskId      String
  completedAt DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id])
  task        SocialTask @relation(fields: [taskId], references: [id])

  @@unique([userId, taskId])
}

model DailyTask {
  id          String  @id @default(uuid())
  title       String
  description String  @default("")
  tokens      Int     @default(0)
  category    String
  link        String  @default("")
  value       Int?
  language    String  @default("en")
  users       UserDailyTask[]
}

model UserDailyTask {
  id          Int       @id @default(autoincrement())
  userId      String
  taskId      String
  completedAt DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  task        DailyTask @relation(fields: [taskId], references: [id])

  @@unique([userId, taskId])
}

model Fight {
  id               String   @id @default(uuid())
  mode             String   @default("pve")     // 'pve' or 'pvp'
  matchId          String?                       // PvP match ID

  fighterOneId     String
  fighterTwoId     String?
  winnerId         String?

  bet              Int      @default(0)
  duration         Int      @default(0)
  actions          Int      @default(0)
  isCompleted      Boolean  @default(false)
  fighterOneActions String  @default("[]")
  fighterTwoActions String  @default("[]")

  // PvP fields
  player1Id        String?
  player2Id        String?
  player1Hp        Int?
  player2Hp        Int?
  winner           String?                       // odId or 'draw' for PvP
  reason           String   @default("normal")   // 'normal', 'disconnect'
  rounds           Int?
  roundLog         Json?

  createdAt        DateTime @default(now())

  fighterOne       User     @relation("FighterOne", fields: [fighterOneId], references: [id])
  fighterTwo       User?    @relation("FighterTwo", fields: [fighterTwoId], references: [id])
  winnerUser       User?    @relation("FightWinner", fields: [winnerId], references: [id])

  @@index([player1Id])
  @@index([player2Id])
  @@index([matchId])
}

model FriendRequest {
  id        String   @id @default(uuid())
  fromId    String
  toId      String
  status    String   @default("pending") // pending, accepted, declined
  createdAt DateTime @default(now())

  from      User     @relation("SentRequests", fields: [fromId], references: [id])
  to        User     @relation("ReceivedRequests", fields: [toId], references: [id])

  @@unique([fromId, toId])
  @@index([toId, status])
  @@index([fromId, status])
}

model Friendship {
  id        String   @id @default(uuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())

  user1     User     @relation("Friendships1", fields: [user1Id], references: [id])
  user2     User     @relation("Friendships2", fields: [user2Id], references: [id])

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model PunchInfo {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  punchAmount            Int      @default(0)
  punchCount             Int      @default(0)
  intervalStartMs        BigInt   @default(0)
  punchAmountMaxPerInterval Int   @default(10000)
  punchAmountMaxPerBatch Int      @default(10000)
  intervalWaitTimeMs     BigInt   @default(3600000)
  user                   User     @relation(fields: [userId], references: [id])
}
