generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Game-cleanup reset (2026-06-01): all game tables (Clan/Agent/Fight/Belt/
// Friends/Tasks/Achievements/FightClub/etc.) were dropped, and all game scalar
// columns were removed from User. Only account / auth / web3 / referral fields
// remain. The new game layer will add its own models from scratch.
model User {
  id              String   @id @default(uuid())
  login           String   @unique
  password        String
  email           String?  @unique
  emailVerified   Boolean  @default(false)
  initialVerified Boolean  @default(true)

  // Email auth flow tokens (migrations 20260508*)
  verifyToken            String?   @unique
  verifyTokenExpiresAt   DateTime?
  resetToken             String?   @unique
  resetTokenExpiresAt    DateTime?

  name            String   @default("Anonymous")
  avatarUrl       String   @default("")
  isBlocked       Boolean  @default(false)
  walletAddress   String?

  // Account settings blob
  settings        Json?

  // Referral system
  referredBy      String?  // login of the user who referred this user
  invitedUsers    Int      @default(0)
  inviteId        String?  @unique @default(uuid())

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
