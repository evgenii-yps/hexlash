# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/hexlash?schema=public"

# JWT Secret - change this in production!
JWT_SECRET="your-super-secret-key-change-me"

# Server
PORT=3000
WS_PORT=444

# Frontend URL for CORS
FRONTEND_URL="http://localhost:5173"

# File uploads directory
UPLOAD_DIR="./uploads"

# AI Trainer (Anthropic Claude API)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Email service (Resend) — Email Auth Phase 2
# RESEND_API_KEY     : from Resend dashboard → API Keys (format: re_xxxxxxxxxxxx)
# EMAIL_FROM_DOMAIN  : verified domain in Resend (e.g. hexlash.com)
# APP_URL            : public app URL for email links (no trailing slash)
RESEND_API_KEY=
EMAIL_FROM_DOMAIN=
APP_URL=
