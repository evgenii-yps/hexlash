+ * взгляду в вертикальной плоскости. `tanX`/`tanY` — полукадр по горизонтали/вертикали.
+ */
+function camScreen(b, x, y, z, tanX, tanY) {
+  const depth = b.deep0 - x * b.nx - y * b.ny - z * b.nz;
