 export function chooseIntentionSpinal(self, foe, memory, fight) {
-  return hardNeed(self, foe, memory, fight) || spinalScore(self, foe, memory, fight);
+  // ЗОНД klich-reach (наклоны кристаллов × клич; только копия дерева). Для решений стороны 'player' с кличем считаем четыре выбора:
+  // act — настоящий; nk — клич убран (наклоны граней остались); nl — убраны и клич, и наклоны граней; rl — клич остался, наклоны граней убраны.
+  const P = globalThis.__PROBE;
+  const run = (o) => hardNeed(o, foe, memory, fight) || spinalScore(o, foe, memory, fight);
+  const act = run(self);
+  if (P && P.on && P.log && self.side === 'player') {
+    const nk = run({ ...self, klich: null }), nl = run({ ...self, klich: null, leans: null }), rl = run({ ...self, leans: null });
+    P.log.push({ t: fight.t, act, nk, nl, rl, kid: self.klich ? self.klich.id : null, kk: self.klich ? self.klich.k : 0 });
+  }
+  return act;
 }
 
